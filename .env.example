# Curator Bot v1.1 — environment variable template (Agent A0 / Stage S-00)
# Copy to `.env` and fill in real values. NEVER commit the real `.env` (see .gitignore).
# All providers below have a genuinely free tier — no credit card required to start.

# Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token-here

# GroqCloud API key — semantic grading (Llama 4 Scout vision) + captions (Llama 3.3 70B)
# Sign up: https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# HuggingFace access token — BLIP-2 scene description (serverless fallback) + grading fallback on Groq 429
# Sign up: https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-token-here
